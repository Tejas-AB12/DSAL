#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void heapify(vector<int>& heap, int n, int i, bool isMaxHeap) {
    int largestOrSmallest = i; 
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (isMaxHeap) {
        if (left < n && heap[left] > heap[largestOrSmallest]) 
            largestOrSmallest = left;
        if (right < n && heap[right] > heap[largestOrSmallest]) 
            largestOrSmallest = right;
    } else {
        if (left < n && heap[left] < heap[largestOrSmallest]) 
            largestOrSmallest = left;
        if (right < n && heap[right] < heap[largestOrSmallest]) 
            largestOrSmallest = right;
    }

    if (largestOrSmallest != i) {
        swap(heap[i], heap[largestOrSmallest]);
        heapify(heap, n, largestOrSmallest, isMaxHeap);
    }
}

int buildHeapAndExtract(vector<int>& marks, bool isMaxHeap) {
    int n = marks.size();
    for (int i = n / 2 - 1; i >= 0; --i) 
        heapify(marks, n, i, isMaxHeap);

    return marks[0];
}

int main() {
    int n;
    cout << "Enter the number of students: ";
    cin >> n;

    vector<int> marks(n);
    cout << "Enter the marks obtained by students: ";
    for (int i = 0; i < n; ++i)
        cin >> marks[i];

    vector<int> maxHeap = marks;
    vector<int> minHeap = marks;

    int maxMarks = buildHeapAndExtract(maxHeap, true);
    int minMarks = buildHeapAndExtract(minHeap, false);

    cout << "Maximum marks: " << maxMarks << endl;
    cout << "Minimum marks: " << minMarks << endl;

    return 0;
}
