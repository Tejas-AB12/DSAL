def liner_probing():
    index =key%size
    if l[index]==-1:
        l[index]=key
        return l
    else:
        for j in range (size):
            p=(index+j)%size
            if l[p]==-1:
                l[p]=key
                return l
            print("Table is full ")
            return l
def quad_probing():
    index=key%size
    if l[index]==-1:
        l[index]=key
        return l
    else:
        for j in range(1,size):
            p=(index+j*j)%size
            if l[p]==-1:
                l[p]=key
                return l
            print("Table is Full ")
            return l
